RABBITMQ_URL=amqp://localhost:5672

# Inbound Oracle integration queue
RMQ_INBOUND_INTEGRATION_EXCHANGE=inbound.integration
RMQ_INBOUND_INTEGRATION_QUEUE=inbound.integration.process
RMQ_INBOUND_INTEGRATION_ROUTING_KEY=inbound.process
RMQ_INBOUND_INTEGRATION_DLX_EXCHANGE=inbound.integration.dlx
RMQ_INBOUND_INTEGRATION_DLX_ROUTING_KEY=inbound.process.dlq

# Outbound PO internal requisition integration queue
RMQ_OUTBOUND_INTEGRATION_EXCHANGE=outbound.integration
RMQ_OUTBOUND_INTEGRATION_QUEUE=outbound.integration.process
RMQ_OUTBOUND_INTEGRATION_ROUTING_KEY=outbound.process
RMQ_OUTBOUND_INTEGRATION_DLX_EXCHANGE=outbound.integration.dlx
RMQ_OUTBOUND_INTEGRATION_DLX_ROUTING_KEY=outbound.process.dlq

# Move order integration status polling queue
RMQ_MOVE_ORDER_INTEGRATION_EXCHANGE=move_order.integration
RMQ_MOVE_ORDER_INTEGRATION_QUEUE=move_order.integration.process
RMQ_MOVE_ORDER_INTEGRATION_ROUTING_KEY=move_order.process
RMQ_MOVE_ORDER_INTEGRATION_DLX_EXCHANGE=move_order.integration.dlx
RMQ_MOVE_ORDER_INTEGRATION_DLX_ROUTING_KEY=move_order.process.dlq

# Move order integration — Redis insert queue only (async create_with_lines)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=master123
REDIS_DB=0
REDIS_MOVE_ORDER_INTEGRATION_QUEUE=move_order.integration.insert.queue

# Email — NNA (mail.nna-id.com)
# SMTP (POST /email/send — omit "smtp" in body to use these defaults)
SMTP_HOST=mail.nna-id.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@nna-id.com
SMTP_PASS=your-password-here
SMTP_FROM=NNA WMS <noreply@nna-id.com>
SMTP_REPLY_TO=noreply@nna-id.com

# IMAP (receive — not used by send module yet; for reference / future inbox)
# IMAP_HOST=mail.nna-id.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=noreply@nna-id.com
# IMAP_PASS=your-password-here

# Snowflake — Call Plan API (scheduled-call-plan)
SNOWFLAKE_STATEMENTS_URL=https://A8518400981671-WY39536.snowflakecomputing.com/api/v2/statements
SNOWFLAKE_ACCESS_TOKEN=your-snowflake-pat-here
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_DATABASE=DEV_SFA_OUTSYSTEMS
SNOWFLAKE_SCHEMA=SFA
SNOWFLAKE_WAREHOUSE=TASK_SFA
SNOWFLAKE_ROLE=ROLE_API

# Call plan scheduling (NestJS @nestjs/schedule + SchedulerRegistry)
# CALL_PLAN_SCHEDULE_MODE=database   # database | memory | off
# CALL_PLAN_CRON=0 8 * * *
# CALL_PLAN_CRON_TIMEZONE=Asia/Jakarta

# On-hand ATR scheduling — fetch findOnHand for all BRANCH/SUBBRANCH cabang
# ON_HAND_ATR_DEFAULT_SUBINVENTORY=KECIL
# ON_HAND_ATR_SCHEDULE_MODE=database   # database | memory | off
# ON_HAND_ATR_CRON=0 6 * * *
# ON_HAND_ATR_CRON_TIMEZONE=Asia/Jakarta
